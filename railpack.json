{
  "$schema": "https://schema.railpack.com",
  "caches": {
    "npm": {
      "directory": "/root/.npm",
      "type": "shared"
    },
    "pip": {
      "directory": "/opt/pip-cache",
      "type": "shared"
    }
  },
  "steps": {
    "install": {
      "caches": ["pip"]
    },
    "build": {
      "caches": ["npm", "pip"]
    }
  }
}

# Copy this file to .env and fill in your values
# Never commit the actual .env file

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/dataanalyst_pro

# JWT secret — use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_secret_string

# Node environment
NODE_ENV=development

# Server port (Railway overrides this automatically)
PORT=3001

# Python analytics service URL (points to Railway service URL in production)
PYTHON_SERVICE_URL=http://localhost:8000

# Zoho CRM (optional)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret

# Groq AI (optional — used for AI assistant)
GROQ_API_KEY=your_groq_api_key
